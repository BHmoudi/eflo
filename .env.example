# ═══════════════════════════════════════════════════════════════════
# Eflo Microservices - Environment Variables Configuration
# ═══════════════════════════════════════════════════════════════════
#
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace all placeholder values with your actual credentials
# 3. Keep .env file secure and never commit it to version control
#
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# KEYCLOAK CONFIGURATION
# ───────────────────────────────────────────────────────────────────
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db_password_2025
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password_2025

# ───────────────────────────────────────────────────────────────────
# POSTGRESQL DATABASES PASSWORDS
# ───────────────────────────────────────────────────────────────────
ORDER_DB_PASSWORD=change_me_order_db_password_2025
WORKFLOW_DB_PASSWORD=change_me_workflow_db_password_2025
COMMISSION_DB_PASSWORD=change_me_commission_db_password_2025
DOCUMENT_DB_PASSWORD=change_me_document_db_password_2025
USER_DB_PASSWORD=change_me_user_db_password_2025
REFERENCE_DB_PASSWORD=change_me_reference_db_password_2025
REPORTING_DB_PASSWORD=change_me_reporting_db_password_2025
ALERT_DB_PASSWORD=change_me_alert_db_password_2025
EXTERNAL_API_DB_PASSWORD=change_me_external_api_db_password_2025
INVOICE_DB_PASSWORD=change_me_invoice_db_password_2025

# ───────────────────────────────────────────────────────────────────
# MINIO (S3 STORAGE) CONFIGURATION
# ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password_2025

# ───────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION
# ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password_2025

# ───────────────────────────────────────────────────────────────────
# ELASTICSEARCH CONFIGURATION
# ───────────────────────────────────────────────────────────────────
ELASTICSEARCH_PASSWORD=change_me_elasticsearch_password_2025

# ───────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (SMTP)
# ───────────────────────────────────────────────────────────────────
EMAIL_USERNAME=noreply@yourdomain.com
EMAIL_PASSWORD=change_me_email_password_2025

# ───────────────────────────────────────────────────────────────────
# SMS CONFIGURATION (TWILIO)
# ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+33123456789

# ───────────────────────────────────────────────────────────────────
# INVOICE SERVICE - DIGITAL SIGNATURE
# ───────────────────────────────────────────────────────────────────
CERTIFICATE_PASSWORD=change_me_certificate_password_2025

# ───────────────────────────────────────────────────────────────────
# EXTERNAL INTEGRATIONS
# ───────────────────────────────────────────────────────────────────

# ISIS Integration (Vehicle Orders Import)
ISIS_USERNAME=isis_api_user
ISIS_PASSWORD=change_me_isis_password_2025

# Move Integration (Accounting Export)
MOVE_API_KEY=your_move_api_key_here

# DIAC Integration (Financing)
DIAC_USERNAME=diac_api_user
DIAC_PASSWORD=change_me_diac_password_2025

# ───────────────────────────────────────────────────────────────────
# n8n WORKFLOW AUTOMATION PLATFORM
# ───────────────────────────────────────────────────────────────────

# n8n Database
N8N_DB_PASSWORD=change_me_n8n_db_password_2025

# n8n Authentication
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_password_2025

# n8n Network Configuration
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# AI Integration for Document Analysis
N8N_AI_ENABLED=true
N8N_AI_PROVIDER=openai
N8N_AI_API_KEY=your_openai_api_key_here
N8N_AI_MODEL=gpt-4

# Alternative AI Providers (uncomment to use)
# N8N_AI_PROVIDER=anthropic
# N8N_AI_API_KEY=your_anthropic_api_key_here
# N8N_AI_MODEL=claude-3-opus-20240229

# WhatsApp Integration via Twilio
N8N_WHATSAPP_ENABLED=true
N8N_WHATSAPP_PROVIDER=twilio
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Alternative: WhatsApp Business API (uncomment to use)
# N8N_WHATSAPP_PROVIDER=whatsapp-business
# WHATSAPP_BUSINESS_API_KEY=your_whatsapp_business_api_key
# WHATSAPP_BUSINESS_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_BUSINESS_ACCESS_TOKEN=your_access_token

# ───────────────────────────────────────────────────────────────────
# OPTIONAL - MONITORING & OBSERVABILITY
# ───────────────────────────────────────────────────────────────────

# Prometheus
PROMETHEUS_ENABLED=false

# Grafana
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password_2025

# Zipkin (Distributed Tracing)
ZIPKIN_ENABLED=false

# ───────────────────────────────────────────────────────────────────
# SECURITY NOTES
# ───────────────────────────────────────────────────────────────────
#
# 1. NEVER commit .env file to Git
# 2. Use strong passwords (minimum 16 characters, mixed case, numbers, symbols)
# 3. Rotate passwords regularly (every 90 days)
# 4. Use different passwords for each service
# 5. Consider using a secrets management tool (HashiCorp Vault, AWS Secrets Manager)
# 6. Enable MFA for admin accounts
# 7. Restrict network access to production databases
# 8. Enable SSL/TLS for all external communications
#
# ═══════════════════════════════════════════════════════════════════
