# ═══════════════════════════════════════════════════════════════════
# Workflow Admin Dashboard - Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# Instructions:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Update values as needed for your environment
#
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ───────────────────────────────────────────────────────────────────

# Application port (default: 3001)
PORT=3001

# Node environment
NODE_ENV=development

# ───────────────────────────────────────────────────────────────────
# BACKEND SERVICE URLS (for development)
# ───────────────────────────────────────────────────────────────────
# Note: In production, these are configured via next.config.js rewrites
# For local development, you can override them here if needed

# Internal API Gateway (main entry point)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# Workflow Service
NEXT_PUBLIC_WORKFLOW_SERVICE_URL=http://localhost:8091

# User Service
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8084

# Order Service
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:8089

# Document Service
NEXT_PUBLIC_DOCUMENT_SERVICE_URL=http://localhost:8083

# ───────────────────────────────────────────────────────────────────
# AUTHENTICATION (Keycloak)
# ───────────────────────────────────────────────────────────────────

# Keycloak server URL
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180

# Keycloak realm
NEXT_PUBLIC_KEYCLOAK_REALM=eflo

# Keycloak client ID
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=workflow-admin

# ───────────────────────────────────────────────────────────────────
# DATABASE (Optional - for direct PostgreSQL access)
# ───────────────────────────────────────────────────────────────────
# Note: Only used for certain admin operations
# Most data access goes through API endpoints

DATABASE_URL=postgresql://workflow_user:workflowpass@localhost:5435/workflow_db

# ───────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ───────────────────────────────────────────────────────────────────

# Enable React Flow workflow designer
NEXT_PUBLIC_ENABLE_WORKFLOW_DESIGNER=true

# Enable GrapesJS document template editor
NEXT_PUBLIC_ENABLE_DOCUMENT_EDITOR=true

# Enable Monaco code editor
NEXT_PUBLIC_ENABLE_CODE_EDITOR=true

# Enable advanced analytics
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ───────────────────────────────────────────────────────────────────
# DEVELOPMENT SETTINGS
# ───────────────────────────────────────────────────────────────────

# Enable debug mode (shows additional console logs)
NEXT_PUBLIC_DEBUG=false

# Mock API responses (for development without backend)
NEXT_PUBLIC_MOCK_API=false

# ───────────────────────────────────────────────────────────────────
# LOGGING & MONITORING
# ───────────────────────────────────────────────────────────────────

# Log level (error, warn, info, debug)
NEXT_PUBLIC_LOG_LEVEL=info

# Enable error reporting (Sentry, etc.)
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=false

# Sentry DSN (if error reporting enabled)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# ───────────────────────────────────────────────────────────────────
# UI CONFIGURATION
# ───────────────────────────────────────────────────────────────────

# Default language (en, fr)
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Available languages
NEXT_PUBLIC_AVAILABLE_LOCALES=en,fr

# Theme (light, dark, system)
NEXT_PUBLIC_DEFAULT_THEME=system

# Items per page (pagination)
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20

# ───────────────────────────────────────────────────────────────────
# PRODUCTION OVERRIDES
# ───────────────────────────────────────────────────────────────────
# For production, create a .env.production file with:
# - Actual production URLs
# - Secure authentication settings
# - Enabled error reporting
# - Disabled debug mode
# ═══════════════════════════════════════════════════════════════════
